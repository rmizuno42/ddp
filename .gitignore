# arXiv submission bundle — duplicates the repository contents; not tracked
arxiv.zip

# Compiled PDF — distributed via GitHub Releases, not committed
paper.pdf

# LaTeX build intermediates (paper.bbl is intentionally tracked and NOT ignored)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bcf
*.run.xml
*.blg

# Local-only historical candidates and original import archives
/legacy/
.DS_Store

# Python execution artifacts
__pycache__/
*.py[cod]

# Imported verification/search logs belong to the certificate provenance.
!results/**/certificate/**/*.log
